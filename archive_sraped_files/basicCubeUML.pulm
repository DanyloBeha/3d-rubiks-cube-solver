@startuml
title Rubik's Cube Structure (classes: Cube, SmallCube, Renderable classes). First iteration

abstract class Renderable {
    +render()
}

class Plate extends Renderable {
    -x: int
    -y: int
    -z: int
    +render(): str
}

class RenderableCube extends Renderable {
    -size: int
    -plates: list
    +generate_plates(): list
    +render(): str
}

class SmallCube {
    -x: int
    -y: int
    -z: int
    +position(): tuple
}

class Cube {
    -size: int
    -plates: list
    +generate_plates(): list
    +list_plane_positions(): list
}

RenderableCube *-- Plate : has-a
Cube *-- SmallCube : has-a

@enduml